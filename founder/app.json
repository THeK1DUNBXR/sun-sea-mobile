{
  "expo": {
    "name": "Sun Sea Insights",
    "slug": "sun-sea-insights",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "android": {
      "package": "in.sunsea.insights",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.sunsea.insights",
      "supportsTablet": true
    },
    "plugins": [
      "expo-splash-screen"
    ],
    "extra": {
      "apiUrl": "https://sunseaerp-production.up.railway.app/api"
    }
  }
}
