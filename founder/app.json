{
  "expo": {
    "name": "Sun Sea Insights",
    "slug": "sun-sea-insights",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#0F2440" },
    "android": {
      "package": "in.sunsea.insights",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0F2440" },
      "permissions": ["INTERNET"]
    },
    "ios": { "bundleIdentifier": "in.sunsea.insights", "supportsTablet": true },
    "plugins": ["expo-splash-screen"],
    "extra": { "apiUrl": "http://192.168.1.10:5000/api" }
  }
}
